<?xml version="1.0" encoding="utf-8"?>

<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">



    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        tools:context="com.mtech.rsrtcsc.ui.activity.concession.Police_Concession">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#1D82D3">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:textSize="25dp"
                    android:layout_gravity="left"
                    android:textColor="@color/white"
                    android:text="RFID Smart Card System"/>

                <ImageView
                    android:id="@+id/ivHumberger"
                    android:layout_width="30dp"
                    android:layout_height="40dp"
                    android:layout_gravity="right"
                    android:layout_marginEnd="10dp"
                    android:src="@drawable/ic_home" />

            </androidx.appcompat.widget.Toolbar>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/fixed_pass"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_margin="10dp"
                android:textSize="22sp"
                android:textColor="#1D82D3"
                android:background="@drawable/rounded_corner"
                android:padding="5dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:padding="5dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/concession_detail"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:padding="2dp"
                    android:textSize="18sp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/rounded_corner"
                    android:backgroundTint="#1D82D3"
                    />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <TextView
                        android:id="@+id/fix_bus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="18sp"
                        android:ems="10"
                        android:textColor="@color/black"
                        android:text="@string/con_bus"
                        android:padding="5dp"
                        android:inputType="none"
                        />

                    <Spinner
                        android:id="@+id/spinner_bus_type"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/gradient_spinner"
                        android:layout_weight="1"
                        android:padding="8dp" />
                </LinearLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <TextView
                        android:id="@+id/con_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ems="10"
                        android:inputType="none"
                        android:padding="5dp"
                        android:text="@string/con_code"
                        android:textColor="@color/black"
                        android:textSize="18sp" />

                    <Spinner
                        android:id="@+id/con_code_spinner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/gradient_spinner"
                        android:padding="8dp"
                        />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    android:weightSum="2">

                    <TextView
                        android:id="@+id/con_code"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ems="10"
                        android:padding="5dp"
                        android:text="Concession Code"
                        android:textColor="@color/black"
                        android:textSize="18sp" />

                    <Spinner
                        android:id="@+id/con_code_spinner2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/gradient_spinner"
                        android:padding="8dp"
                        />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <TextView
                        android:id="@+id/con_type"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="18sp"
                        android:ems="10"
                        android:textColor="@color/black"
                        android:text="@string/con_type"
                        android:padding="5dp"
                        android:inputType="none"
                        />

                    <Spinner
                        android:id="@+id/con_type_spinner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/gradient_spinner"
                        android:layout_weight="1"
                        android:padding="8dp" />

                    <!--        <TextView-->
                    <!--            android:layout_width="match_parent"-->
                    <!--            android:layout_height="wrap_content"-->
                    <!--            android:id="@+id/tv"-->
                    <!--            android:layout_weight="1"-->
                    <!--            android:hint="select"/>-->

                </LinearLayout>



                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <TextView
                        android:id="@+id/pass_period"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ems="10"
                        android:inputType="none"
                        android:padding="5dp"
                        android:text="@string/pass_period"
                        android:textColor="@color/black"
                        android:textSize="18sp" />

                    <Spinner
                        android:id="@+id/pas_period"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/gradient_spinner"
                        android:padding="8dp"
                        />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:visibility="invisible"
                    android:weightSum="2">


                    <TextView
                        android:id="@+id/textView_endDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="18sp"
                        android:ems="10"
                        android:backgroundTint="#E8E6E6"
                        android:textColor="@color/black"
                        android:text="@string/end_date"
                        android:inputType="none"
                        android:padding="5dp"
                        />

                    <TextView
                        android:id="@+id/date_pick"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/rounded_corner"
                        android:padding="5dp"
                        android:textColor="@color/black"
                        android:textSize="18sp"
                        android:hint="@string/end_date_hint"
                        />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_position"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    android:weightSum="2">


                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="18sp"
                        android:ems="10"
                        android:backgroundTint="#E8E6E6"
                        android:textColor="@color/black"
                        android:text="@string/position"
                        android:inputType="none"
                        android:padding="5dp"
                        />

                    <EditText
                        android:id="@+id/position"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/rounded_corner"
                        android:padding="5dp"
                        android:textColor="@color/black"
                        android:textSize="18sp"
                        android:hint="@string/position_hint"
                        />
                </LinearLayout>


            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_select_stop"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:padding="5dp"
                android:visibility="gone"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/select_stop"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:padding="2dp"
                    android:textSize="18sp"
                    android:background="@drawable/rounded_corner"
                    android:backgroundTint="#000080"
                    />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <TextView
                        android:id="@+id/from_stop"
                        android:layout_width="130dp"
                        android:layout_height="wrap_content"
                        android:textSize="18sp"
                        android:ems="10"
                        android:textColor="@color/black"
                        android:text="@string/from_stop"
                        android:padding="5dp"
                        android:inputType="none"
                        />

                    <AutoCompleteTextView
                        android:id="@+id/tv_from_stop"
                        android:layout_width="220dp"
                        android:layout_height="wrap_content"
                        android:hint="From Stop"
                        android:completionThreshold="1"
                        android:layout_weight="1" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal"
                    android:weightSum="2">



                    <TextView
                        android:id="@+id/till_stop"
                        android:layout_width="130dp"
                        android:layout_height="wrap_content"
                        android:ems="10"
                        android:inputType="none"
                        android:padding="3dp"
                        android:text="@string/till_stop"
                        android:textColor="@color/black"
                        android:textSize="18sp" />



                    <AutoCompleteTextView
                        android:id="@+id/tv_till_stop"
                        android:layout_width="220dp"
                        android:layout_height="wrap_content"
                        android:hint="Till Stop"
                        android:completionThreshold="1"
                        android:layout_weight="1"
                        android:completionHint="Select Till Stop"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <TextView
                        android:id="@+id/fix_bus2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="18sp"
                        android:ems="10"
                        android:textColor="@color/black"
                        android:text="@string/con_bus"
                        android:padding="5dp"
                        android:inputType="none"
                        />

                    <Spinner
                        android:id="@+id/spinner_bus_type2"
                        android:layout_width="300dp"
                        android:layout_height="wrap_content"
                        android:background="@drawable/gradient_spinner"
                        android:layout_weight="1"
                        android:padding="8dp" />
                </LinearLayout>


                <Button
                    android:id="@+id/search_Route"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Search Route"
                    android:layout_marginTop="10dp"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:weightSum="2"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_back"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BACK"
                    android:gravity="center"
                    android:layout_marginLeft="8dp"
                    android:layout_marginRight="8dp"
                    android:layout_weight="1"
                    android:textSize="16sp"/>

                <Button
                    android:id="@+id/btn_next"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Next"
                    android:gravity="center"
                    android:layout_marginLeft="8dp"
                    android:layout_marginRight="8dp"
                    android:layout_weight="1"
                    android:layout_gravity="center"
                    android:textSize="16sp"/>

                <!--                    <Button-->
                <!--                        android:id="@+id/btn_clear"-->
                <!--                        android:layout_width="wrap_content"-->
                <!--                        android:layout_height="wrap_content"-->
                <!--                        android:text="Back"-->
                <!--                        android:gravity="center"-->
                <!--                        android:layout_marginLeft="8dp"-->
                <!--                        android:layout_marginRight="8dp"-->
                <!--                        android:layout_weight="1"-->
                <!--                        android:textSize="16sp"/>-->
            </LinearLayout>



        </LinearLayout>
    </ScrollView>
</layout>
