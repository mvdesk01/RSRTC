<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    >
    <data>
        <variable
            name="model"
            type="com.mtech.rsrtcsc.model.request.LoginModel" />
    </data>



<RelativeLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context="com.mtech.rsrtcsc.ui.activity.auth.login.LoginActivity">

    <androidx.appcompat.widget.Toolbar
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1D82D3">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="RFID Smart Card System"
            android:textColor="@color/white"
            android:textSize="25dp"
            android:textStyle="bold" />

    </androidx.appcompat.widget.Toolbar>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="70dp"
        android:orientation="vertical">


        <ImageView
            android:layout_width="130dp"
            android:layout_height="130dp"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"
            android:background="@drawable/rsrtc01" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="0dp"
            android:text="Rajasthan State Road Transport Corporation"
            android:textColor="#047CC4"
            android:textSize="25dp"
            android:textStyle="bold" />

        <!--    <EditText-->
        <!--        android:layout_width="match_parent"-->
        <!--        android:layout_height="wrap_content"-->
        <!--        android:hint="Enter Mobile Number"-->
        <!--        android:layout_marginTop="160dp"-->
        <!--        android:layout_marginLeft="16dp"-->
        <!--        android:padding="5dp"-->
        <!--        android:background="@drawable/rounded_corner"-->
        <!--        android:layout_marginRight="16dp"/>-->

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilMobileNo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="30dp"
            android:layout_marginRight="16dp"
            android:background="@drawable/rounded_corner"
            android:backgroundTint="#FFFFFF"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:inputType="number"
            tools:ignore="MissingConstraints">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/tieMobileNo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#FFFFFF"
                android:hint="Enter Mobile Number"
                android:inputType="number"
                android:maxLength="10"
                android:text="@={model.mobileNo}" />
        </com.google.android.material.textfield.TextInputLayout>


        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="16dp"
            android:background="@drawable/rounded_corner"
            android:backgroundTint="#FFFFFF"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:inputType="textPassword"
            app:passwordToggleEnabled="true"
            app:passwordToggleTint="#FB0303"
            tools:ignore="MissingConstraints">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/tiePassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#FFFFFF"
                android:ems="10"
                android:hint="Enter password"
                android:inputType="textPassword"
                android:singleLine="true"
                android:text="@={model.password}"

                />
        </com.google.android.material.textfield.TextInputLayout>


        <!--            <EditText-->
        <!--        android:layout_width="match_parent"-->
        <!--        android:layout_height="wrap_content"-->
        <!--        android:hint="Enter Password"-->
        <!--        android:padding="5dp"-->
        <!--        app:passwordToggleEnabled="true"-->
        <!--        android:focusable="true"-->
        <!--        app:passwordToggleTint="#F60404"-->
        <!--        android:inputType="textPassword"-->
        <!--        android:background="@drawable/rounded_corner"-->
        <!--        android:layout_marginTop="16dp"-->
        <!--        android:layout_marginLeft="16dp"-->
        <!--        android:layout_marginRight="16dp"/>-->


        <Button
            android:id="@+id/btnLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"
            android:text="Login" />

        <TextView
            android:id="@+id/tvRegister"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="16dp"
            android:gravity="center"
            android:padding="5dp"
            android:text="New User Please Register Here!"
            android:textColor="#1D82D3"
            android:textSize="15dp"
            android:textStyle="bold" />


        <TextView
            android:id="@+id/tvForgotPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="16dp"
            android:gravity="center"
            android:padding="5dp"
            android:text="Forgot Password"
            android:textColor="#1D82D3"
            android:textSize="15dp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt"
            android:layout_width="match_parent"
            android:layout_marginTop="20dp"
            android:textColor="@color/black"
            android:layout_height="wrap_content"/>

    </LinearLayout>

    <ProgressBar
        android:id="@+id/simpleProgressBar"
        android:layout_width="wrap_content"
        android:layout_centerInParent="true"
        android:visibility="gone"
        android:layout_height="wrap_content" />


</RelativeLayout>

</layout>