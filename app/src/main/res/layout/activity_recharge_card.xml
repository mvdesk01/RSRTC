        android:padding="5dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded_corner"
            android:backgroundTint="#000080"
            android:gravity="center"
            android:padding="2dp"
            android:text="@string/charg_detail"
