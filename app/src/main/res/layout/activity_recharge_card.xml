                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:gravity="center"
                android:padding="8dp"
                android:textColor="@color/black"
                android:textColorHighlight="#FFEB3B"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:id="@+id/layoutperiod"
        android:layout_below="@+id/cardinfo"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:weightSum="2">

        <TextView
            android:id="@+id/pass_periodd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ems="10"
            android:inputType="none"
            android:padding="5dp"
            android:text="@string/pass_periodmonth"
            android:textColor="@color/black"
            android:textSize="18sp" />

        <Spinner
            android:id="@+id/pasperiodddd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/gradient_spinner"
            android:padding="8dp"
            />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        android:id="@+id/buttonLayout"
        android:layout_below="@+id/layoutperiod"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:weightSum="2">

    <Button
        android:id="@+id/calculatefare"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Calculate Fare"
        android:layout_marginTop="10dp"
        android:layout_below="@+id/layoutperiod"
        android:gravity="center"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="8dp"
        android:layout_gravity="center"
        android:textSize="16sp"/>
    >
    </LinearLayout>


    <LinearLayout
